{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "ignorePatterns": [
    "node_modules",
    ".next",
    "out",
    "build",
    "coverage",
    "pnpm-lock.yaml",
    "next-env.d.ts",
    ".agents"
  ],
  "sortImports": {
    "ignoreCase": true,
    "newlinesBetween": true,
    "sortSideEffects": true,
    "internalPattern": ["@/"],
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react-dom", "react-dom/**"]
      },
      {
        "groupName": "next",
        "elementNamePattern": ["next", "next/**"]
      }
    ],
    "groups": [
      "react",
      "next",
      ["builtin", "external"],
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      ["style", "side_effect_style"],
      "unknown"
    ]
  },
  "sortTailwindcss": {
    "stylesheet": "app/globals.css",
    "functions": ["cn", "cva", "clsx"]
  }
}
